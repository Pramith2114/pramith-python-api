USE_AWS_RDS=true
RDS_HOST=database-1.cj2sqc0u6bdr.eu-north-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DATABASE=postgres
RDS_USERNAME=your_database_username
RDS_PASSWORD=your_database_password
AWS_REGION=eu-north-1
USE_IAM_AUTH=false

